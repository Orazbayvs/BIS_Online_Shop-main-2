# Copy this file to configdrf/.env (git-ignored). Django loads it automatically;
# real environment variables always take priority over values in this file.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# PostgreSQL (the project database). With a Homebrew or Postgres.app install the
# defaults just work: database "onlineshop", your macOS user, no password, localhost:5432.
POSTGRES_DB=onlineshop
# POSTGRES_USER=your-macos-user
# POSTGRES_PASSWORD=
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Or give one full URL instead of the POSTGRES_* values (hosted databases need TLS):
# DATABASE_URL=postgresql://onlineshop:replace-me@db.example:5432/onlineshop?sslmode=require
# DJANGO_DB_CONN_MAX_AGE=60

# Optional: SQLite instead of PostgreSQL (quick experiments only)
# DATABASE_URL=sqlite:////absolute/path/to/db.sqlite3

# Production defaults are secure. Set this to False only when a trusted TLS
# terminating proxy forwards HTTP to this local Django process.
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_USE_X_FORWARDED_PROTO=True
